# Example .env for Paranjape Foods
# Replace <db_password> with your cluster password (URL-encode special characters)
# Example URI (replace <db_password> and optionally the database name at the end):
MONGODB_URI=mongodb+srv://sahil:<db_password>@paranjapefoods.vokug.mongodb.net/paranjapefoods

# Backend port (optional, default in server.js is 4000)
PORT=4000

# Optional: If you host the backend separately, set the frontend base URL to call the API
# Example: https://api.yourdomain.com
# In Next.js you can use NEXT_PUBLIC_API_BASE to configure client-side fetches
NEXT_PUBLIC_API_BASE=http://localhost:4000
