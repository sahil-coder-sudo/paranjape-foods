# Example .env for Paranjape Foods
# Replace <db_password> with your cluster password (URL-encode special characters)
# Example URI (replace <db_password> and optionally the database name at the end):
MONGODB_URI=mongodb+srv://sahil:<db_password>@paranjapefoods.vokug.mongodb.net/paranjapefoods

# Backend port (optional, default in server.js is 4000)
PORT=4000

# Optional: If you host the backend separately, set the frontend base URL to call the API
# Example: https://api.yourdomain.com
# In Next.js you can use NEXT_PUBLIC_API_BASE to configure client-side fetches
NEXT_PUBLIC_API_BASE=http://localhost:4000

# Razorpay keys (get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google Maps API key (for address validation)
# Get from https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyAVYZbWjJxvEq0mCv__EtvcK6N-b4B8s3Y
GOOGLE_GEOCODING_API_KEY=AIzaSyCZTUAO6QJa2WpMceJpQWtfGGzfvQRVxaQ
# Porter delivery API (set up later)
PORTER_API_KEY=your_porter_api_key
PORTER_PARTNER_ID=your_porter_partner_id

# Staff & Kitchen Manager Portal Passcode / PIN
MANAGER_PASSCODE=paranjape2026

# Delivery Partner Portal Passcode / PIN
DELIVERY_PASSCODE=rider2026


