{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build --workspace=frontend && cp -R frontend/.next .next",
  "outputDirectory": ".next",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://paranjape-foods.herokuapp.com/api/:path*"
    }
  ]
}
